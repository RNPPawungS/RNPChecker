<%- include('_head') %>
<h1><%= t('ผู้ใช้งาน') %></h1>
<div class="card table"><div class="scroll"><table>
<thead><tr><th><%= t('อีเมล') %></th><th><%= t('ชื่อ') %></th><th><%= t('สิทธิ์') %></th><th><%= t('สถานะ') %></th><th><%= t('เข้าใช้ล่าสุด') %></th><th></th></tr></thead><tbody>
<% users.forEach(u => { %>
<tr><td><%= u.email %></td><td><%= u.name %></td>
<td><%= t(u.role==='admin'?'ผู้ดูแล':'ผู้ใช้') %></td>
<td><span class="tag <%= u.status %>"><%= t({pending:'รออนุมัติ',active:'ใช้งาน',disabled:'ระงับ|status'}[u.status] || u.status) %></span></td>
<td class="sm muted"><%= dmy(u.last_login_at) %></td>
<td class="row"><% if (u.id !== user.id) { %>
  <form method="post" action="/users/<%= u.id %>">
  <% if (u.status!=='active') { %><button name="status" value="active" class="btn sm"><%= t('อนุมัติ') %></button><% } else { %><button name="status" value="disabled" class="btn danger sm"><%= t('ระงับ') %></button><% } %>
  <button name="role" value="<%= u.role==='admin'?'user':'admin' %>" class="btn ghost sm"><%= t(u.role==='admin'?'ถอดผู้ดูแล':'ตั้งเป็นผู้ดูแล') %></button>
  </form><% } %></td></tr>
<% }) %>
</tbody></table></div></div>
<%- include('_foot') %>

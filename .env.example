PORT=3000
BASE_URL=https://packing.rnpexpress.co.th
SESSION_SECRET=change-me
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=packing
DB_PASSWORD=change-me
DB_NAME=packing
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# อีเมลที่เป็น admin อัตโนมัติ (คั่นด้วย ,) ถ้าว่าง คนแรกที่ login จะเป็น admin
ADMIN_EMAILS=
# true = ผู้ใช้ใหม่ต้องรอ admin อนุมัติ, false = ใช้งานได้ทันที
REQUIRE_APPROVAL=true
# URL ที่เครื่อง Android ใช้เข้าเซิร์ฟเวอร์ (ใช้ทำ QR ดาวน์โหลดแอป) ค่าเริ่มต้น https://10.80.0.9
APP_SERVER_URL=https://10.80.0.9
# Google Sheet connector: import แถวใหม่จาก Google Sheet อัตโนมัติ (ดู README หัวข้อ "เชื่อม Google Sheet") ว่าง = ปิด
# GOOGLE_SHEET_ID = ส่วนของ URL ระหว่าง /d/ กับ /edit
GOOGLE_SHEET_ID=
GOOGLE_SHEET_TAB=DATA
GOOGLE_SERVICE_ACCOUNT_FILE=/opt/packing/google-service-account.json
# ตรวจ sheet ทุกกี่วินาที (อย่างน้อย 15)
SHEET_POLL_SECONDS=60
# เริ่มอ่านจากแถวที่ (2 = ทุกแถวใต้หัวคอลัมน์) ใช้ข้ามข้อมูลเก่าได้
SHEET_START_ROW=2
